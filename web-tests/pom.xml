<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.foxtrot</groupId>
        <artifactId>qa-automation-ui</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>web-tests</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- Parallelism for web JUnit5 execution -->
        <thread-count>4</thread-count>

        <!-- Web runtime defaults -->
        <selenide.remote></selenide.remote>
        <encryption.test.user>TEST49</encryption.test.user>
        <encryption.peer.user>TEST48</encryption.peer.user>
        <encryption.key.ttl.minutes>1</encryption.key.ttl.minutes>
        <!-- SKR network-fault (WEB-010/011): hold = client timeout 60s + 20s margin -->
        <encryption.skr.abort.hold.ms>80000</encryption.skr.abort.hold.ms>
        <encryption.skr.client.retry.wait.ms>100000</encryption.skr.client.retry.wait.ms>
        <encryption.skr.logout.wait.sec>60</encryption.skr.logout.wait.sec>

        <!-- IDEA gutter копирует это поле как -Drun.channel (последний -D побеждает VM options).
             desktop — как было до выноса канала из Surefire. Web: mvn -Drun.channel=web -->
        <run.channel>desktop</run.channel>
        <desktop.platform>mac</desktop.platform>
        <desktop.locale>ru</desktop.locale>
        <desktop.app.version>latest</desktop.app.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.foxtrot</groupId>
            <artifactId>qa-core</artifactId>
        </dependency>

        <!-- Electron launcher для run.channel=desktop -->
        <dependency>
            <groupId>org.foxtrot</groupId>
            <artifactId>desktop-tests</artifactId>
        </dependency>

        <!-- Web testing -->
        <dependency>
            <groupId>com.codeborne</groupId>
            <artifactId>selenide</artifactId>
        </dependency>

        <dependency>
            <groupId>com.codeborne</groupId>
            <artifactId>selenide-selenoid</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>

        <!-- Allure + Selenide -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
        </dependency>

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-selenide</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-commons</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        <selenide.remote>${selenide.remote}</selenide.remote>
                        <baseApiUrl>${baseApiUrl}</baseApiUrl>
                        <pusherBaseUrl>${pusherBaseUrl}</pusherBaseUrl>
                        <baseUrl>${baseUrl}</baseUrl>
                        <backofficeApiUrl>${backofficeApiUrl}</backofficeApiUrl>
                        <backofficeOrganizationId>${backofficeOrganizationId}</backofficeOrganizationId>
                        <encryption.test.user>${encryption.test.user}</encryption.test.user>
                        <encryption.peer.user>${encryption.peer.user}</encryption.peer.user>
                        <encryption.key.ttl.minutes>${encryption.key.ttl.minutes}</encryption.key.ttl.minutes>
                        <encryption.skr.abort.hold.ms>${encryption.skr.abort.hold.ms}</encryption.skr.abort.hold.ms>
                        <encryption.skr.client.retry.wait.ms>${encryption.skr.client.retry.wait.ms}</encryption.skr.client.retry.wait.ms>
                        <encryption.skr.logout.wait.sec>${encryption.skr.logout.wait.sec}</encryption.skr.logout.wait.sec>

                        <desktop.platform>${desktop.platform}</desktop.platform>
                        <desktop.locale>${desktop.locale}</desktop.locale>
                        <desktop.app.version>${desktop.app.version}</desktop.app.version>
                        <run.channel>${run.channel}</run.channel>

                        <junit.jupiter.execution.parallel.enabled>true</junit.jupiter.execution.parallel.enabled>
                        <junit.jupiter.execution.parallel.mode.default>same_thread</junit.jupiter.execution.parallel.mode.default>
                        <junit.jupiter.execution.parallel.mode.classes.default>concurrent</junit.jupiter.execution.parallel.mode.classes.default>
                        <junit.jupiter.execution.parallel.config.strategy>fixed</junit.jupiter.execution.parallel.config.strategy>
                        <junit.jupiter.execution.parallel.config.fixed.parallelism>${thread-count}</junit.jupiter.execution.parallel.config.fixed.parallelism>
                        <junit.jupiter.execution.parallel.config.fixed.max-pool-size>${thread-count}</junit.jupiter.execution.parallel.config.fixed.max-pool-size>
                    </systemPropertyVariables>

                    <environmentVariables>
                        <SELENIUM_LOG_FILE>${project.build.directory}/selenium.log</SELENIUM_LOG_FILE>
                    </environmentVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Parent -Pstage14 sets run.channel=web, but this module's <properties>
         desktop wins. Repeat here so encryption CI / Selenoid не уходит в Electron. -->
    <profiles>
        <profile>
            <id>stage14</id>
            <properties>
                <run.channel>web</run.channel>
                <encryption.key.ttl.minutes>1</encryption.key.ttl.minutes>
            </properties>
        </profile>
    </profiles>
</project>
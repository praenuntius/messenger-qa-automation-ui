backofficeSuperAdminOtp=111111

# Опционально: свой JSESSIONID вместо автологина
# backofficeSessionId=

# Preprod: Autotest_org
backofficeOrganizationId=128644
# Stage14: Autotest_org (id=1007501) — см. environments/stage14-backoffice.properties
backofficeWhitelistInitiator=qa-automation

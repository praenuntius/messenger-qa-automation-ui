#!/usr/bin/env bash
# See https://docs.docker.com/compose/environment-variables/#the-env-file

# Environment where containers run
# Possible values: local | staging | production
APP_ENV=local

# Docker
COMPOSE_FILES=-f docker-compose.yml
RECREATE_MODE=--force-recreate

COMPOSE_PROJECT_NAME=qa-automation-ui
HOST_MACHINE_IP_ADDRESS=172.20.0.22
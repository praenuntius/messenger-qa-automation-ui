/**
 * SKR soak и key-ttl — длинные тесты (много SSE / смена ключа / ожидание TTL).
 *
 * Jenkins job (создать, Script Path = этот файл):
 *   encryption_soak_preprod → имя содержит preprod, энв подхватится сам
 *   encryption_Soak_stg14   → stage14
 *
 * Имя джобы важнее параметра ENV: *_stg14 всегда stage14, даже если в форме выбран preprod.
 *
 * Запускать, когда TTL ключа на сервере = 1 минута.
 * KEY_TTL_MINUTES по умолчанию 1. При 30 мин на сервере soak не увидит протухание.
 *
 * 4 стрима параллельно, у каждого своя пара пользователей (не пересекается со smoke):
 *   API key-ttl, Web, Android, iOS.
 * Android и iOS оба просят label mac-mobile: настоящий параллель — два исполнителя.
 * Один Mac — второй стрим встанет в очередь, устройства не делят.
 *
 * Клиенты: Web (Selenoid) параллельно с мобилками.
 *   agent none — иначе top-level `agent any` держит linux-executor и nested
 *   `agent { label 'mac-mobile' }` часто не стартует (или ждёт до таймаута).
 *
 * Job timeout = 12h. Таймаут стрима: SOAK_MINUTES+90 (soak плюс key-ttl ожидания).
 *
 * Smoke encryption_api_stg14 этот файл НЕ использует (там Jenkinsfile.encryption + !soak).
 *
 * SCM "Branches to build" = ветка, где лежит этот Jenkinsfile.
 */
pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 12, unit: 'HOURS')
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['stage14', 'preprod'],
            description: 'Target environment (stg14 в JOB_NAME → stage14 автоматически)'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Git branch with soak tests'
        )
        string(
            name: 'KEY_TTL_MINUTES',
            defaultValue: '1',
            description: 'TTL на сервере в минутах. Soak/key-ttl рассчитаны на 1. Не ставить 30.'
        )
        string(
            name: 'API_USER',
            defaultValue: 'TEST68',
            description: 'API key-ttl. Не шарить со smoke (там TEST47) и с UI-стримами.'
        )
        string(
            name: 'WEB_USER',
            defaultValue: 'TEST70',
            description: 'Web soak owner'
        )
        string(
            name: 'WEB_PEER',
            defaultValue: 'TEST71',
            description: 'Web soak peer (API inbound)'
        )
        string(
            name: 'ANDROID_USER',
            defaultValue: 'TEST72',
            description: 'Android soak owner'
        )
        string(
            name: 'ANDROID_PEER',
            defaultValue: 'TEST73',
            description: 'Android soak peer (API inbound)'
        )
        string(
            name: 'IOS_USER',
            defaultValue: 'TEST74',
            description: 'iOS soak owner'
        )
        string(
            name: 'IOS_PEER',
            defaultValue: 'TEST75',
            description: 'iOS soak peer (API inbound)'
        )
        string(
            name: 'SOAK_MINUTES',
            defaultValue: '10',
            description: '-Dencryption.soak.minutes. Часы: 180. Клиенты параллельны, бюджет ≈ SOAK+25 + prepare.'
        )
        string(
            name: 'SOAK_TICK_SECONDS',
            defaultValue: '90',
            description: '-Dencryption.soak.tick.seconds'
        )
        string(
            name: 'ANDROID_APK',
            defaultValue: '',
            description: 'APK filename in MOBILE_APPS_DIR. Empty = foxtrot_dev.apk (stage14) or tango_preprod.apk (preprod).'
        )
        booleanParam(
            name: 'SKIP_API',
            defaultValue: false,
            description: 'Skip API key-ttl (SKR-API-010)'
        )
        booleanParam(
            name: 'SKIP_WEB',
            defaultValue: false,
            description: 'Skip Web soak'
        )
        booleanParam(
            name: 'SKIP_ANDROID',
            defaultValue: false,
            description: 'Skip Android soak'
        )
        booleanParam(
            name: 'SKIP_IOS',
            defaultValue: false,
            description: 'Skip iOS soak'
        )
    }

    environment {
        SELENOID_URL = 'http://selenoid:4444/wd/hub'
        SELENOID_BASE = 'http://selenoid:4444'
        ALLURE_ENDPOINT = 'https://testops.domain.net'
        ALLURE_PROJECT_ID = '8'
        JAVA_TOOL_OPTIONS = '-Dfile.encoding=UTF-8'
        MAVEN_OPTS = '-Xmx3g -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8'
    }

    stages {
        stage('Prepare') {
            agent any
            steps {
                script {
                    env.TARGET_ENV = resolveTargetEnv()
                    env.MAVEN_PROFILE = env.TARGET_ENV == 'stage14' ? '-Pstage14' : ''
                    env.LAUNCH_PREFIX = "Encryption soak ${env.TARGET_ENV}"
                    env.KEY_TTL_MINUTES = params.KEY_TTL_MINUTES?.trim() ? params.KEY_TTL_MINUTES.trim() : '1'
                    env.MOBILE_APK = params.ANDROID_APK?.trim()
                            ? params.ANDROID_APK.trim()
                            : (env.TARGET_ENV == 'stage14'
                            ? 'foxtrot_dev.apk'
                            : 'tango_preprod.apk')
                    env.MOBILE_APPS_DIR = env.TARGET_ENV == 'stage14'
                            ? '/Users/messengerqa/NOT-PREPROD-mobile-apps'
                            : '/Users/messengerqa/mobile-apps'
                    env.SOAK_MINUTES = params.SOAK_MINUTES
                    env.SOAK_TICK_SECONDS = params.SOAK_TICK_SECONDS
                    env.SELENOID_SESSION_TIMEOUT = "${soakMinutes() + 45}m"

                    echo "SOAK Job=${env.JOB_NAME} | Env=${env.TARGET_ENV} | Branch=${params.BRANCH} | minutes=${env.SOAK_MINUTES} | ttl=${env.KEY_TTL_MINUTES} | stageTimeout=${soakStageTimeoutMinutes()}m | APK=${env.MOBILE_APK} | appsDir=${env.MOBILE_APPS_DIR} | users api=${params.API_USER} web=${params.WEB_USER}/${params.WEB_PEER} android=${params.ANDROID_USER}/${params.ANDROID_PEER} ios=${params.IOS_USER}/${params.IOS_PEER}"

                    cleanWs()
                    checkout([
                        $class           : 'GitSCM',
                        branches         : [[name: "*/${params.BRANCH}"]],
                        userRemoteConfigs: scm.userRemoteConfigs
                    ])

                    sh """
                        mvn install -DskipTests -pl web-tests,mobile-tests -am ${env.MAVEN_PROFILE} -B -q
                    """

                    withCredentials([string(credentialsId: 'allure-api-key', variable: 'ALLURE_TOKEN')]) {
                        configureAllure(env.ALLURE_TOKEN)
                    }

                    stash name: 'encryption-soak-built', includes: '**/*', excludes: '**/.git/**'
                }
            }
        }

        stage('Soak clients') {
            parallel {
                stage('API key-ttl') {
                    when { expression { !params.SKIP_API } }
                    agent any
                    steps {
                        script {
                            echo "SOAK API starting on ${env.NODE_NAME} user=${params.API_USER}"
                            catchError(buildResult: 'FAILURE', stageResult: 'UNSTABLE') {
                                timeout(time: soakStageTimeoutMinutes(), unit: 'MINUTES') {
                                    runOnIsolatedWorkspace('api') {
                                        withCredentials([string(credentialsId: 'allure-api-key', variable: 'ALLURE_TOKEN')]) {
                                            runWebSoak(
                                                    launchName: "${env.LAUNCH_PREFIX} - API",
                                                    streamId: 'api',
                                                    groups: 'encryption-suite & api & key-ttl',
                                                    logFile: 'logs/encryption-soak-api.log',
                                                    testUser: params.API_USER,
                                                    peerUser: params.API_USER,
                                                    namePrefix: 'skr-api-'
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                stage('Web soak') {
                    when { expression { !params.SKIP_WEB } }
                    agent any
                    steps {
                        script {
                            echo "SOAK Web starting on ${env.NODE_NAME} user=${params.WEB_USER}"
                            catchError(buildResult: 'FAILURE', stageResult: 'UNSTABLE') {
                                timeout(time: soakStageTimeoutMinutes(), unit: 'MINUTES') {
                                    runOnIsolatedWorkspace('web') {
                                        setupSelenoid()
                                        try {
                                            withCredentials([string(credentialsId: 'allure-api-key', variable: 'ALLURE_TOKEN')]) {
                                                runWebSoak(
                                                        launchName: "${env.LAUNCH_PREFIX} - Web",
                                                        streamId: 'web',
                                                        groups: 'encryption-suite & web & (soak | key-ttl)',
                                                        logFile: 'logs/encryption-soak-web.log',
                                                        testUser: params.WEB_USER,
                                                        peerUser: params.WEB_PEER,
                                                        namePrefix: 'skr-web-'
                                                )
                                            }
                                        } finally {
                                            cleanupSelenoid()
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                stage('Android soak') {
                    when { expression { !params.SKIP_ANDROID } }
                    agent { label 'mac-mobile' }
                    steps {
                        script {
                            echo "SOAK Android starting on ${env.NODE_NAME} user=${params.ANDROID_USER}"
                            catchError(buildResult: 'FAILURE', stageResult: 'UNSTABLE') {
                                timeout(time: soakStageTimeoutMinutes(), unit: 'MINUTES') {
                                    runMobileSoak('android')
                                }
                            }
                        }
                    }
                }
                stage('iOS soak') {
                    when { expression { !params.SKIP_IOS } }
                    agent { label 'mac-mobile' }
                    steps {
                        script {
                            echo "SOAK iOS starting on ${env.NODE_NAME} user=${params.IOS_USER}"
                            catchError(buildResult: 'FAILURE', stageResult: 'UNSTABLE') {
                                timeout(time: soakStageTimeoutMinutes(), unit: 'MINUTES') {
                                    runMobileSoak('ios')
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Encryption SOAK finished. Per-stream logs archived in Web/Mobile stages.'
        }
        failure {
            echo 'Encryption SOAK failed. Check logs/encryption-soak-*.log'
        }
    }
}

def resolveTargetEnv() {
    def job = env.JOB_NAME?.toLowerCase() ?: ''
    if (job.contains('stg14') || job.contains('stage14')) {
        return 'stage14'
    }
    if (job.contains('preprod')) {
        return 'preprod'
    }
    return params.ENV
}

def configureAllure(token) {
    sh """
        ALLURE_HOME="\${HOME:-/var/jenkins_home}/.allure"
        mkdir -p "\$ALLURE_HOME" logs
        cat > "\$ALLURE_HOME/config.yaml" <<EOF
project_id: ${ALLURE_PROJECT_ID}
endpoint: ${ALLURE_ENDPOINT}
token: ${token}
EOF
    """
}

def runOnIsolatedWorkspace(String suffix, Closure body) {
    def mainWs = env.WORKSPACE
    ws("${env.WORKSPACE}@${suffix}") {
        cleanWs()
        unstash 'encryption-soak-built'
        try {
            body()
        } finally {
            sh """
                mkdir -p '${mainWs}/logs' \\
                         '${mainWs}/web-tests/target/surefire-reports' \\
                         '${mainWs}/web-tests/target/allure-results'
                cp -a logs/. '${mainWs}/logs/' 2>/dev/null || true
                cp -a web-tests/target/surefire-reports/. '${mainWs}/web-tests/target/surefire-reports/' 2>/dev/null || true
                cp -a web-tests/target/allure-results/. '${mainWs}/web-tests/target/allure-results/' 2>/dev/null || true
            """
            junit testResults: 'web-tests/target/surefire-reports/TEST-*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'logs/**/*.log, web-tests/target/surefire-reports/**/*', allowEmptyArchive: true
        }
    }
}

def runWebSoak(Map cfg) {
    def groups = cfg.groups ?: 'encryption-suite & web & (soak | key-ttl)'
    def logFile = cfg.logFile ?: 'logs/encryption-soak-web.log'
    def testUser = cfg.testUser ?: params.WEB_USER
    def peerUser = cfg.peerUser ?: params.WEB_PEER
    def namePrefix = cfg.namePrefix ?: 'skr-web-'
    withEnv([
            "JUNIT_GROUPS=${groups}",
            "LAUNCH_NAME=${cfg.launchName}",
            "LOG_FILE=${logFile}",
            "ALLURE_TOKEN=${ALLURE_TOKEN}",
            "ALLURE_STREAM_ID=${cfg.streamId}",
            "SOAK_MINUTES=${env.SOAK_MINUTES}",
            "SOAK_TICK_SECONDS=${env.SOAK_TICK_SECONDS}",
            "SELENOID_SESSION_TIMEOUT=${env.SELENOID_SESSION_TIMEOUT}",
            "TEST_USER=${testUser}",
            "PEER_USER=${peerUser}",
            "NAME_PREFIX=${namePrefix}",
            "KEY_TTL_MINUTES=${env.KEY_TTL_MINUTES}"
    ]) {
        sh '''
            set -e
            mkdir -p logs web-tests/target/allure-results

            cat > logs/run-web-soak.sh <<EOF
#!/usr/bin/env bash
set -euo pipefail
mvn test -pl web-tests ${MAVEN_PROFILE} -B \\
  -Dmaven.main.skip=true \\
  -Dgroups="\${JUNIT_GROUPS}" \\
  -DfailIfNoTests=true \\
  -Dremote=true \\
  -Dselenide.remote=\${SELENOID_URL} \\
  -Dselenoid.hub.url=\${SELENOID_URL} \\
  -Dencryption.test.user=\${TEST_USER} \\
  -Dencryption.peer.user=\${PEER_USER} \\
  -Dencryption.key.ttl.minutes=\${KEY_TTL_MINUTES} \\
  -Dencryption.soak.minutes=\${SOAK_MINUTES} \\
  -Dencryption.soak.tick.seconds=\${SOAK_TICK_SECONDS} \\
  -Dencryption.soak.rotate.every.ticks=0 \\
  -Dencryption.soak.quiet.logs=true \\
  -Dencryption.soak.name.prefix=\${NAME_PREFIX} \\
  -Dselenoid.enable.video=false \\
  -Dselenoid.session.timeout=\${SELENOID_SESSION_TIMEOUT} \\
  -Dsurefire.redirectTestOutputToFile=true \\
  -Djunit.jupiter.execution.parallel.enabled=false \\
  -Dthread-count=1
EOF
            chmod +x logs/run-web-soak.sh

            unset CI || true
            unset ALLURE_CI_TYPE ALLURE_JOB_RUN_ID ALLURE_LAUNCH_ID || true
            unset ALLURE_JOB_UID ALLURE_JOB_NAME ALLURE_JOB_URL || true
            unset ALLURE_JOB_RUN_UID ALLURE_JOB_RUN_NAME ALLURE_JOB_RUN_URL ALLURE_JOB_RUN_BRANCH || true

            export ALLURE_LAUNCH_NAME="${LAUNCH_NAME}"
            export ALLURE_JOB_UID="${JOB_BASE_NAME:-encryption-soak}-${ALLURE_STREAM_ID}"
            export ALLURE_JOB_RUN_UID="${BUILD_NUMBER}-${ALLURE_STREAM_ID}"

            echo "SOAK Web: groups=[$JUNIT_GROUPS] minutes=[$SOAK_MINUTES] launch=[$LAUNCH_NAME]"

            set +e
            ./logs/run-web-soak.sh > "${LOG_FILE}" 2>&1
            TEST_EC=$?
            set -e

            allurectl upload \\
                --endpoint="${ALLURE_ENDPOINT}" \\
                --project-id="${ALLURE_PROJECT_ID}" \\
                --launch-name="${LAUNCH_NAME}" \\
                --job-uid="${ALLURE_JOB_UID}" \\
                --job-run-uid="${ALLURE_JOB_RUN_UID}" \\
                web-tests/target/allure-results \\
                >> "${LOG_FILE}" 2>&1 \\
                || { echo "==== allurectl upload failed ===="; tail -n 80 "${LOG_FILE}"; exit 1; }

            if [ "$TEST_EC" -ne 0 ]; then
                echo "==== ${LOG_FILE} (failed ec=$TEST_EC) ===="
                cat "${LOG_FILE}"
                exit "$TEST_EC"
            fi
        '''
    }
}

def runMobileSoak(String platform) {
    cleanWs()
    unstash 'encryption-soak-built'
    prepareMobileApp(platform)

    withCredentials([string(credentialsId: 'allure-api-key', variable: 'ALLURE_TOKEN')]) {
        configureAllure(env.ALLURE_TOKEN)

        def capitalized = platform.substring(0, 1).toUpperCase() + platform.substring(1)
        def junitGroups = platform == 'android'
                ? 'encryption-suite & mobile & !ios & (soak | key-ttl) & !chaos'
                : 'encryption-suite & mobile & !android & (soak | key-ttl) & !chaos'
        def testUser = platform == 'android' ? params.ANDROID_USER : params.IOS_USER
        def peerUser = platform == 'android' ? params.ANDROID_PEER : params.IOS_PEER
        withEnv([
                "JUNIT_GROUPS=${junitGroups}",
                "LAUNCH_NAME=${env.LAUNCH_PREFIX} - ${capitalized}",
                "LOG_FILE=logs/encryption-soak-${platform}.log",
                "PLATFORM_NAME=${platform}",
                "TEST_USER=${testUser}",
                "PEER_USER=${peerUser}",
                "KEY_TTL_MINUTES=${env.KEY_TTL_MINUTES}",
                "SOAK_MINUTES=${env.SOAK_MINUTES}",
                "SOAK_TICK_SECONDS=${env.SOAK_TICK_SECONDS}",
                "MOBILE_APK=${env.MOBILE_APK}",
                "ALLURE_TOKEN=${ALLURE_TOKEN}",
                "ALLURE_STREAM_ID=${platform}"
        ]) {
            try {
                sh '''
                    set -e
                    mkdir -p logs mobile-tests/target/allure-results
                    export ANDROID_HOME="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Library/Android/sdk}}"
                    export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"

                    cat > logs/run-mobile-soak.sh <<EOF
#!/usr/bin/env bash
set -euo pipefail
export ANDROID_HOME="\${ANDROID_HOME:-\${ANDROID_SDK_ROOT:-\$HOME/Library/Android/sdk}}"
export PATH="\$ANDROID_HOME/cmdline-tools/latest/bin:\$ANDROID_HOME/platform-tools:\$PATH"
mvn install -DskipTests -pl mobile-tests -am ${MAVEN_PROFILE} -B -q
mvn test -pl mobile-tests ${MAVEN_PROFILE} -B \\
  -Dplatform.name="\${PLATFORM_NAME}" \\
  -Dgroups="\${JUNIT_GROUPS}" \\
  -Dencryption.test.user="\${TEST_USER}" \\
  -Dencryption.peer.user="\${PEER_USER}" \\
  -Dencryption.key.ttl.minutes="\${KEY_TTL_MINUTES}" \\
  -Dencryption.soak.minutes="\${SOAK_MINUTES}" \\
  -Dencryption.soak.tick.seconds="\${SOAK_TICK_SECONDS}" \\
  -Dencryption.soak.quiet.logs=true \\
  -Dencryption.soak.name.prefix=skr-\${PLATFORM_NAME}- \\
  -Dandroid.apk.file.name="\${MOBILE_APK}" \\
  -Dsurefire.redirectTestOutputToFile=true \\
  -Djunit.jupiter.execution.parallel.enabled=false \\
  -Dthread.count=1 \\
  -DfailIfNoTests=true
EOF
                    chmod +x logs/run-mobile-soak.sh

                    unset CI || true
                    unset ALLURE_CI_TYPE ALLURE_JOB_RUN_ID ALLURE_LAUNCH_ID || true
                    unset ALLURE_JOB_UID ALLURE_JOB_NAME ALLURE_JOB_URL || true
                    unset ALLURE_JOB_RUN_UID ALLURE_JOB_RUN_NAME ALLURE_JOB_RUN_URL ALLURE_JOB_RUN_BRANCH || true

                    export ALLURE_LAUNCH_NAME="${LAUNCH_NAME}"
                    export ALLURE_JOB_UID="${JOB_BASE_NAME:-encryption-soak}-${ALLURE_STREAM_ID}"
                    export ALLURE_JOB_RUN_UID="${BUILD_NUMBER}-${ALLURE_STREAM_ID}"

                    echo "SOAK Mobile: platform=[$PLATFORM_NAME] minutes=[$SOAK_MINUTES] launch=[$LAUNCH_NAME]"

                    set +e
                    ./logs/run-mobile-soak.sh > "${LOG_FILE}" 2>&1
                    TEST_EC=$?
                    set -e

                    allurectl upload \\
                        --endpoint="${ALLURE_ENDPOINT}" \\
                        --project-id="${ALLURE_PROJECT_ID}" \\
                        --launch-name="${LAUNCH_NAME}" \\
                        --job-uid="${ALLURE_JOB_UID}" \\
                        --job-run-uid="${ALLURE_JOB_RUN_UID}" \\
                        mobile-tests/target/allure-results \\
                        >> "${LOG_FILE}" 2>&1 \\
                        || { echo "==== allurectl upload failed ===="; tail -n 80 "${LOG_FILE}"; exit 1; }

                    if [ "$TEST_EC" -ne 0 ]; then
                        echo "==== ${LOG_FILE} (failed ec=$TEST_EC) ===="
                        cat "${LOG_FILE}"
                        exit "$TEST_EC"
                    fi
                '''
            } finally {
                junit testResults: 'mobile-tests/target/surefire-reports/TEST-*.xml', allowEmptyResults: true
                archiveArtifacts artifacts: "logs/**/*.log, mobile-tests/build/reports/**/*, mobile-tests/target/surefire-reports/**/*", allowEmptyArchive: true
            }
        }
    }
}

def prepareMobileApp(String platform) {
    def appsDir = env.TARGET_ENV == 'stage14'
            ? '/Users/messengerqa/NOT-PREPROD-mobile-apps'
            : '/Users/messengerqa/mobile-apps'
    def apkName = params.ANDROID_APK?.trim()
            ? params.ANDROID_APK.trim()
            : (env.TARGET_ENV == 'stage14' ? 'foxtrot_dev.apk' : 'tango_preprod.apk')
    env.MOBILE_APPS_DIR = appsDir
    env.MOBILE_APK = apkName
    echo "SOAK prepareMobileApp platform=${platform} appsDir=${appsDir} apk=${apkName}"

    withEnv(["MOBILE_APPS_DIR=${appsDir}", "MOBILE_APK=${apkName}"]) {
        sh """
            mkdir -p logs mobile-tests/src/test/resources/application

            if [ -z "\${MOBILE_APPS_DIR}" ] || [ ! -d "\${MOBILE_APPS_DIR}" ]; then
                echo "ERROR: MOBILE_APPS_DIR missing or not a directory: \${MOBILE_APPS_DIR}"
                exit 1
            fi

            if [ "${platform}" = "android" ]; then
                APK_SRC=""
                if [ -f "\${MOBILE_APPS_DIR}/\${MOBILE_APK}" ]; then
                    APK_SRC="\${MOBILE_APPS_DIR}/\${MOBILE_APK}"
                elif [ "${env.TARGET_ENV}" = "stage14" ]; then
                    APK_SRC=\$(ls -t "\${MOBILE_APPS_DIR}"/foxtrot*.apk 2>/dev/null | head -n 1 || true)
                fi
                if [ -z "\$APK_SRC" ]; then
                    echo "ERROR: APK not found. Looked for \${MOBILE_APK} in \${MOBILE_APPS_DIR}"
                    echo "Available files:"
                    ls -la "\${MOBILE_APPS_DIR}" || true
                    exit 1
                fi
                echo "Using Android APK: \$APK_SRC -> \${MOBILE_APK}"
                cp "\$APK_SRC" "mobile-tests/src/test/resources/application/\${MOBILE_APK}"
                ls -lh "mobile-tests/src/test/resources/application/\${MOBILE_APK}"
            fi

            if [ "${platform}" = "ios" ]; then
                rm -rf mobile-tests/src/test/resources/application/Messenger.app
                cp -R "\${MOBILE_APPS_DIR}/Messenger.app" \\
                      "mobile-tests/src/test/resources/application/Messenger.app"
                ls -lah mobile-tests/src/test/resources/application/Messenger.app
            fi
        """
    }
}

def setupSelenoid() {
    sh '''
        mkdir -p logs
        docker images | grep -q "selenoid/chrome.*128.0" || docker pull selenoid/chrome:128.0
        docker ps -aq --filter ancestor=selenoid/chrome:128.0 | xargs -r docker rm -f || true
    '''
}

def cleanupSelenoid() {
    sh '''
        curl -X DELETE ${SELENOID_URL}/session/* 2>&1 || true
        docker ps -aq --filter ancestor=selenoid/chrome:128.0 | xargs -r docker rm -f || true
    '''
}

def soakMinutes() {
    try {
        return Math.max(1, (params.SOAK_MINUTES ?: '10').toInteger())
    } catch (Exception ignored) {
        return 10
    }
}

def soakStageTimeoutMinutes() {
    return soakMinutes() + 90
}

def soakJobTimeoutMinutes() {
    return soakMinutes() + 45
}
